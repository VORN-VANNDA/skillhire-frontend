VITE_API_BASE_URL=http://localhost:5000/api
# Note: on macOS, port 5000 is often taken by the AirPlay Receiver
# (Control Center), which answers with a bare 403 and no CORS headers —
# that shows up in the browser as a false "blocked by CORS policy" error.
# If your backend's own .env uses a different PORT (check skillhire-backend/.env),
# point this at that port instead, e.g. http://localhost:5001/api.
